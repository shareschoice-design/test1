 {"vo": "Weeks later, they were holding hands.", "hl": ["holding"], "label": "March 6", "shots": [{"file": "HOLDING_HANDS"}]},
 {"vo": "Engaged on July 4th.", "hl": ["engaged"], "label": "July 4", "shots": [{"file": "PROPOSAL_RING"}]},
